# HL CopyTrade - Environment Variables
# Usage: cp .env.example .env && vim .env

# Your HL main wallet address
HL_USER_MAIN_ADDR=0xYOUR_WALLET_ADDRESS

# Leader address to follow
HL_LEADER_ADDR=0xLEADER_ADDRESS

# API wallet private key (generate from Hyperliquid website)
HL_API_PRIVATE_KEY=0xYOUR_API_WALLET_PRIVATE_KEY

# API wallet name
HL_API_WALLET_NAME=trading-bot

# Feishu/Lark alert webhook URL (optional)
HL_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK_ID

# Copy trade fund ratio (0-1, 0.9 means 90%)
HL_FUND_RATIO=0.9

# Log level
HL_LOG_LEVEL=INFO
